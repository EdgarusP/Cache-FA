library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity cache_fsm is

    port (
        clock     : in std_logic;
        reset     : in std_logic;
        req_valid : in std_logic;
        capturar : out std_logic;
        buscar   : out std_logic;
        busy : out std_logic;
        done : out std_logic
    );

end cache_fsm;


architecture Behavioral of cache_fsm is

    type state_type is (IDLE, LOOKUP, FINISH);

    signal state : state_type := IDLE;

begin

    capturar <= '1' when state = IDLE and
                         req_valid = '1'
                else '0';

    buscar <= '1' when state = LOOKUP else '0';
    busy <= '1' when state = LOOKUP else '0';
    done <= '1' when state = FINISH else '0';

    process(clock)
    begin

        if rising_edge(clock) then

            if reset = '1' then

                state <= IDLE;

            else

                case state is

                    when IDLE =>

                        if req_valid = '1' then

                            state <= LOOKUP;

                        end if;

                    when LOOKUP =>

                        state <= FINISH;

                    when FINISH =>

                        state <= IDLE;

                end case;
            end if;
        end if;
    end process;
end Behavioral;
